# Convex deployment URL (auto-populated by `npx convex dev` into .env.local)
NEXT_PUBLIC_CONVEX_URL=

# --- Set on the Convex backend, NOT here ---
# The CoC API token is a Convex environment variable so it never reaches the
# client. Create a token at https://developer.clashofclans.com with the
# RoyaleAPI proxy IP (45.79.218.79) whitelisted, then run:
#   npx convex env set COC_API_TOKEN <your-token>

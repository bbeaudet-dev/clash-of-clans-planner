# Convex deployment URL (auto-populated by `npx convex dev` into .env.local)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Set on the Convex backend, NOT here ---
# The CoC API token is a Convex environment variable so it never reaches the
# client. Create a token at https://developer.clashofclans.com with the
# RoyaleAPI proxy IP (45.79.218.79) whitelisted, then run:
#   npx convex env set COC_API_TOKEN <your-token>
#
# Better Auth also reads these from Convex env vars:
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set BETTER_AUTH_SECRET <random-base64-secret>
#   npx convex env set GOOGLE_CLIENT_ID <google-client-id>
#   npx convex env set GOOGLE_CLIENT_SECRET <google-client-secret>
#   npx convex env set APPLE_CLIENT_ID <apple-services-id>
#   npx convex env set APPLE_CLIENT_SECRET <apple-client-secret-jwt>
